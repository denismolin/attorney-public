# Secrets
.env

# Environnement Python local
.venv/
__pycache__/
*.pyc

# Données confidentielles de la succession (emails .eml, pièces jointes,
# index, bases). RIEN du dossier data/ ne doit partir sur GitHub.
# Couvre data/sources/ (emails .eml, uploads/) et data/generated/ (PJ extraites,
# texte OCR, app.sqlite, settings.json).
data/
*.sqlite
*.db

# Volumes Docker (bind mounts — data/ est hors OneDrive, mais au cas où)
pg-data/

# Archives de migration (export des bases — confidentiel et volumineux)
backups/

# Réglages saisis via l'UI (clés API en clair). Déjà couvert par data/, explicité ici.
data/generated/settings.json

# Divers
.DS_Store
*.log

# Outils locaux (contiennent des chemins et noms du poste de développement)
graphify-out/
.claude/
