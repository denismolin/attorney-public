# ============================================================================
# Configuration de l'assistant juridique RAG — Succession
# Copier ce fichier en `.env` et renseigner les valeurs.
# Le `.env` n'est JAMAIS commité (cf .gitignore).
# ============================================================================

# --- Choix des providers (au lancement) ---------------------------------------
# EMBED_PROVIDER : openai | mistral | vllm   (PAS anthropic — pas d'API embeddings)
# CHAT_PROVIDER  : openai | anthropic | mistral | vllm
EMBED_PROVIDER=openai
CHAT_PROVIDER=openai

# --- Modèles ------------------------------------------------------------------
EMBED_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4o
# Exemples par provider :
#   openai    -> EMBED_MODEL=text-embedding-3-large  CHAT_MODEL=gpt-4o
#   mistral   -> EMBED_MODEL=mistral-embed           CHAT_MODEL=mistral-large-latest
#   anthropic ->                                     CHAT_MODEL=claude-opus-4-8  (chat only)
#   vllm      -> EMBED_MODEL=<ton-modele-embed>      CHAT_MODEL=auto
# Astuce vLLM : CHAT_MODEL=auto -> l'app détecte le modèle instruct déployé via
# /models et s'adapte automatiquement si tu le changes côté serveur.

# --- Clés API (selon providers choisis) ---------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- vLLM (service HTTPS perso, API OpenAI-compatible) ------------------------
VLLM_BASE_URL=https://your-vllm-host/v1
VLLM_API_KEY=

# --- ChromaDB (service Docker séparé) -----------------------------------------
# En dev local : localhost. Dans le compose : chromadb (nom du service).
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Flask --------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Subpath prefix when deployed behind a reverse proxy (e.g. /attorney/). Leave as / for root deployment.
APPLICATION_ROOT=/
# Clé de session Flask (obligatoire pour l'authentification). Générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si laissée vide, une clé est générée une fois et conservée avec les données
# (GENERATED_DIR/.session_key, jamais exportée).
FLASK_SECRET_KEY=

# Requêtes modifiantes : refusées si elles viennent d'un autre site. Si l'application est
# servie sous un nom que le proxy ne transmet pas (en-tête Host), listez-le ici.
# TRUSTED_ORIGINS=dossiers.exemple.fr

# Conteneur : l'application tourne sous le compte propriétaire du dossier de données
# (à défaut 10001), jamais en root. Pour imposer un compte : APP_UID / APP_GID.
# APP_UID=1000
# APP_GID=1000

# Textes propres au dossier par défaut (prompts, exemples, mots-clés) : fichier privé hors
# de l'image, par défaut SOURCE_DIR/_private/default_case.json (cf. case_private.py).
# CASE_PRIVATE_FILE=/chemin/vers/default_case.json

# Derrière un proxy HTTPS : n'envoyer le cookie de session que sur HTTPS.
# SESSION_COOKIE_SECURE=1

# --- Authentification -----------------------------------------------------------
# Premier démarrage (aucun compte) :
#  - ADMIN_PASSWORD vide  -> assistant d'installation dans le navigateur, protégé par un
#    code à usage unique affiché dans les logs au démarrage ;
#  - ADMIN_PASSWORD rempli -> le compte admin est créé au démarrage, sans assistant.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Indexation ---------------------------------------------------------------
# Taille cible des chunks (caractères approx.) et recouvrement.
CHUNK_SIZE=3500
CHUNK_OVERLAP=400

# --- Répertoires de données (optionnel — défauts sous data/) -------------------
# SOURCE_DIR    : entrée fournie par toi — emails "mails de */" + uploads/.
# GENERATED_DIR : sorties techniques — PJ extraites, texte OCR, app.sqlite, settings.json.
# Laisse vide pour garder les défauts (data/sources, data/generated). Utile si tu
# veux séparer les sources confidentielles des données régénérables (autre disque,
# volume Docker différent, backup ciblé, etc.).
# SOURCE_DIR=data/sources
# GENERATED_DIR=data/generated

# --- Base vectorielle sur une autre machine (facultatif) --------------------------
# Peut aussi se régler dans l'UI (Réglages > Base vectorielle), qui prend alors le pas.
# CHROMA_SSL=1
# CHROMA_AUTH_HEADER=Authorization: Bearer <jeton>

# --- Boîte de collecte (facultatif) ----------------------------------------------
# Se règle normalement dans l'UI (Réglages > Boîte de collecte). Désactivée par défaut.
# IMAP_ENABLED=1
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=dossiers@exemple.fr
# IMAP_PASSWORD=
# MAILBOX_ALLOWED_SENDERS=@exemple.fr
